import os
import sys
import json
import importlib
import warnings
import pandas as pd
import mlflow
import mlflow.sklearn
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier
from sklearn.model_selection import GridSearchCV
from sklearn.metrics import accuracy_score, precision_score
from fastapi.testclient import TestClient

warnings.filterwarnings('ignore')

BASE_DIR = "."
DATA_DIR = f"{BASE_DIR}/data/processed"
SRC_DIR = f"{BASE_DIR}/src"
MLRUNS_DIR = f"{BASE_DIR}/mlruns"
csv_path = f"{DATA_DIR}/f1_dataset_clean.csv"

os.makedirs(DATA_DIR, exist_ok=True)
os.makedirs(SRC_DIR, exist_ok=True)

print("\n--- FASE 0: Configurando DVC ---")
os.system("dvc init --no-scm > null 2>&1")
os.makedirs(f"{BASE_DIR}/dvc_remote", exist_ok=True)
os.system(f"dvc remote add -d drive_remoto {BASE_DIR}/dvc_remote > null 2>&1")

if os.path.exists(csv_path):
    os.system(f"dvc add {csv_path}")
    os.system("dvc push")
    print(f" DVC trackeando el archivo: {csv_path}.dvc generado.")
else:
    print(f"No se encuentra el CSV. Pon tu f1_dataset_clean.csv dentro de la carpeta data/processed/")
    sys.exit()

print("\n--- FASE 1 & 2: Entrenamiento y MLflow ---")
df = pd.read_csv(csv_path)
df = df.dropna(subset=['positionOrder'])
df['is_points'] = (df['positionOrder'] <= 10).astype(int)

X_train, y_train = df[df['year'] < 2022][['grid', 'year']], df[df['year'] < 2022]['is_points']
X_test, y_test = df[df['year'] == 2022][['grid', 'year']], df[df['year'] == 2022]['is_points']

mlflow.set_tracking_uri(f"file://{os.path.abspath(MLRUNS_DIR).replace('\\\\', '/')}")
mlflow.set_experiment("F1_Model_Competition")

diccionario_modelos = {
    "Regresion_Logistica": {"estimador": LogisticRegression(max_iter=1000), "grid_params": {"C": [0.1, 1.0, 10.0]}},
    "Random_Forest": {"estimador": RandomForestClassifier(random_state=42), "grid_params": {"n_estimators": [50], "max_depth": [5]}},
    "Gradient_Boosting": {"estimador": GradientBoostingClassifier(random_state=42), "grid_params": {"n_estimators": [50], "learning_rate": [0.1]}}
}

for nombre_modelo, config in diccionario_modelos.items():
    print(f"Entrenando: {nombre_modelo}...")
    with mlflow.start_run(run_name=nombre_modelo):
        buscador = GridSearchCV(config["estimador"], config["grid_params"], cv=3, scoring='accuracy')
        buscador.fit(X_train, y_train)
        mejor_modelo = buscador.best_estimator_
        y_pred = mejor_modelo.predict(X_test)
        
        mlflow.log_params(buscador.best_params_)
        mlflow.log_metric("accuracy", accuracy_score(y_test, y_pred))
        mlflow.sklearn.log_model(mejor_modelo, "modelo_f1")

runs = mlflow.search_runs(experiment_names=["F1_Model_Competition"])
ganador = runs.sort_values("metrics.accuracy", ascending=False).iloc[0]
print(f"\n🏆 Mejor modelo: {ganador['tags.mlflow.runName']} con Accuracy de {ganador['metrics.accuracy']:.4f}")

print("\n--- FASE 3: Generando API y Pruebas ---")
ruta_modelo_encontrada = None
for root, dirs, files in os.walk(MLRUNS_DIR):
    if 'MLmodel' in files and 'model.pkl' in files:
        ruta_modelo_encontrada = root
        break

if ruta_modelo_encontrada:
    print(f" Artefacto localizado en MLflow: {ruta_modelo_encontrada}")
    codigo_api = f"""from fastapi import FastAPI\nfrom pydantic import BaseModel\nimport mlflow\nimport pandas as pd\n\nclass PilotoInput(BaseModel):\n    grid: int\n    year: int\n\napp = FastAPI()\nmodelo_f1 = None\n\n@app.on_event("startup")\ndef cargar_modelo():\n    global modelo_f1\n    modelo_f1 = mlflow.sklearn.load_model("file://{os.path.abspath(ruta_modelo_encontrada).replace('\\\\', '/')}")\n\n@app.post("/predecir")\ndef hacer_prediccion(datos: PilotoInput):\n    df_entrada = pd.DataFrame([{{\"grid\": datos.grid, \"year\": datos.year}}])\n    prediccion = modelo_f1.predict(df_entrada)[0]\n    return {{"posicion_salida": datos.grid, "año_carrera": datos.year, "prediccion_modelo": "Sí (Top 10)" if prediccion == 1 else "No"}}\n"""
    
    with open(f"{SRC_DIR}/api.py", 'w', encoding="utf-8") as f:
        f.write(codigo_api)
    
    sys.path.append(os.path.abspath(BASE_DIR))
    if 'src.api' in sys.modules: importlib.reload(sys.modules['src.api'])
    from src.api import app

    print("\n--- FASE 4: Ejecutando Petición de Prueba ---")
    with TestClient(app) as client:
        respuesta = client.post("/predecir", json={"grid": 5, "year": 2025})
        print("RESPUESTA DE LA API:")
        print(json.dumps(respuesta.json(), indent=2, ensure_ascii=False))
